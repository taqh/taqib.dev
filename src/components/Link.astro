---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
  class?: string;
  external?: boolean;
  forward?: boolean;
  href: string;
  variant?: "card" | "icon" | "button";
}

function getVariantClasses(linkVariant?: Props["variant"]) {
  if (linkVariant === "card") {
    return "flex-col hover:bg-background/80 backdrop-blur-sm p-4 text-base";
  }
  if (linkVariant === "icon") {
    return "p-2 border-none";
  }
  if (linkVariant === "button") {
    return "hover:bg-border focus-visible:bg-border";
  }
  return "px-4 py-2 items-center justify-center text-sm";
}

const {
  href,
  external,
  forward,
  class: classNames,
  variant,
  ...attrs
} = Astro.props;
---

<a
  class={`group font-sans rounded-md flex border hover:bg-card cursor-pointer transition focus-visible:outline-dashed focus-visible:outline-2 focus-visible:outline-emerald-500 duration-300 focus-visible:outline-offset-2 ${getVariantClasses(variant)} ${classNames}`}
  href={href}
  target={external ? "_blank" : "_self"}
  {...attrs}
>
  <slot />
  {external && variant !== "icon" && (
      <svg
        class="lucide lucide-arrow-up-right translate-x-1.5 transition duration-300 group-hover:translate-x-2.5 group-hover:-translate-y-0.5 group-focus-visible:translate-x-3 group-focus-visible:-translate-y-0.5"
        fill="none"
        height="16"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        viewBox="0 0 24 24"
        width="16"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path d="M7 7h10v10" />
        <path d="M7 17 17 7" />
      </svg>
    )}
  {forward && (
      <svg
        class="absolute top-1/2 right-4 size-5 -translate-y-1/2 fill-none stroke-2 stroke-current"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <line
          class="translate-x-3 scale-x-0 transition-transform duration-300 ease-in-out group-hover:translate-x-0 group-hover:scale-x-100"
          x1="5"
          x2="19"
          y1="12"
          y2="12"
        />
        <polyline
          class="-translate-x-1 transition-transform duration-300 ease-in-out group-hover:translate-x-0"
          points="12 5 19 12 12 19"
        />
      </svg>
    )}
</a>

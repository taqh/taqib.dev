---
interface Props {
  href: string;
  title: string;
}

const { href, title } = Astro.props;
---

<a
  class="group inline-flex items-center gap-2 text-base text-muted-foreground transition-colors duration-200 hover:text-foreground focus-visible:outline-dashed focus-visible:outline-2 focus-visible:outline-accent"
  href={href}
  title="Back to blog"
>
  <svg
    aria-hidden="true"
    class="size-4 fill-none stroke-current transition-transform duration-200 group-hover:-translate-x-0.5"
    viewBox="0 0 24 24"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path
      d="m15 18-6-6 6-6"
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="1.5"
    />
  </svg>
  <span>{title}</span>
</a>

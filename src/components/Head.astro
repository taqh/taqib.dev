---
import "@/styles/global.css";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";

interface Props {
  description: string;
  image?: string;
  title: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image = "/og.webp" } = Astro.props;
---

<!-- Global Metadata -->
<meta charset="utf-8">
<meta content="width=device-width,initial-scale=1" name="viewport">
<meta
  content="#f6f2ee"
  media="(prefers-color-scheme: light)"
  name="theme-color"
>
<meta content="#1a1a1a" media="(prefers-color-scheme: dark)" name="theme-color">
<meta content={Astro.generator} name="generator">

<!-- Favicons -->
<link href="/favicon.svg" rel="icon" type="image/svg+xml">
<link href="/favicon-96x96.png" rel="icon" sizes="96x96" type="image/png">
<link href="/favicon.ico" rel="shortcut icon">
<link href="/apple-touch-icon.png" rel="apple-touch-icon" sizes="180x180">
<meta content="Taqib" name="apple-mobile-web-app-title">
<link href="/site.webmanifest" rel="manifest">

<!-- Canonical URL -->
<link href={canonicalURL} rel="canonical">

<!-- Page Meta Tags -->
<title>{title}</title>
<meta content={title} name="title">
<meta content={description} name="description">

<!-- Open Graph Tags -->
<meta content="website" property="og:type">
<meta content={Astro.url} property="og:url">
<meta content={title} property="og:title">
<meta content={description} property="og:description">
<meta content={new URL(image, Astro.url)} property="og:image">

<!-- Twitter Open Graph -->
<meta content="summary_large_image" property="twitter:card">
<meta content={Astro.url} property="twitter:url">
<meta content={title} property="twitter:title">
<meta content={description} property="twitter:description">
<meta content={new URL(image, Astro.url)} property="twitter:image">

<!-- Fonts -->
<Font cssVariable="--font-inter" preload />
<Font cssVariable="--font-literata" preload />

<ClientRouter />

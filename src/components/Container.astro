---
import type { HTMLAttributes } from "astro/types";
import { cn } from "@/lib/utils";

interface Props extends HTMLAttributes<"div"> {}
const { class: classNames, ...attrs } = Astro.props;
---

<div
  class={cn(
    "z-10 mx-auto h-full w-full min-w-0 max-w-3xl px-6 md:px-10 lg:px-14",
    classNames,
  )}
  {...attrs}
>
  <slot />
</div>

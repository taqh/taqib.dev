---
import Github from "@/components/icons/Github.astro";
import Mail from "@/components/icons/Mail.astro";
import X from "@/components/icons/X.astro";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;

const links = [
  {
    href: "mailto:hi@taqib.dev",
    icon: Mail,
    label: "Email",
  },
  {
    href: "https://github.com/taqh",
    icon: Github,
    label: "GitHub",
  },
  {
    href: "https://x.com/retaqib",
    icon: X,
    label: "Twitter",
  },
];
---

<div class:list={["flex flex-wrap items-center gap-2", className]}>
  {links.map(({ href, icon: Icon, label }) => (
    <a
      class="inline-flex min-h-8 items-center gap-2 rounded-full bg-muted px-3 py-1.5 text-muted-foreground text-sm transition-colors duration-150 hover:text-foreground focus-visible:outline-dashed focus-visible:outline-2 focus-visible:outline-accent active:scale-[0.96]"
      href={href}
      rel={href.startsWith("http") ? "noopener" : undefined}
      target={href.startsWith("http") ? "_blank" : undefined}
    >
      <Icon class="size-3.5 shrink-0" />
      <span>{label}</span>
    </a>
  ))}
</div>

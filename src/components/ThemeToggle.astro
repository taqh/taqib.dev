<button
  aria-label="Switch to dark theme"
  aria-pressed="false"
  class="relative grid size-8 shrink-0 place-content-center rounded-full bg-muted text-muted-foreground transition-colors duration-150 hover:text-foreground active:scale-[0.96] focus-visible:outline-dashed focus-visible:outline-2 focus-visible:outline-accent"
  data-theme-toggle
  type="button"
>
  <svg
    aria-hidden="true"
    class="size-4"
    fill="none"
    height="24"
    stroke="currentColor"
    stroke-linecap="round"
    stroke-linejoin="round"
    stroke-width="2"
    viewBox="0 0 24 24"
    width="24"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path d="M0 0h24v24H0z" fill="none" stroke="none"></path>
    <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0-18 0"></path>
    <path d="M12 3v18"></path>
    <path d="m12 9 4.65-4.65"></path>
    <path d="m12 14.3 7.37-7.37"></path>
    <path d="m12 19.6 8.85-8.85"></path>
  </svg>
</button>

<script>
  type Theme = "dark" | "light";

  type ThemeTransitionDocument = Document & {
    startViewTransition?: (callback: () => void) => {
      finished: Promise<void>;
      ready: Promise<void>;
    };
  };

  const getSystemTheme = (): Theme =>
    window.matchMedia("(prefers-color-scheme: dark)").matches
      ? "dark"
      : "light";

  const getStoredTheme = (): Theme | null => {
    const storedTheme = localStorage.getItem("theme");
    return storedTheme === "dark" || storedTheme === "light"
      ? storedTheme
      : null;
  };

  const getCurrentTheme = (): Theme =>
    document.documentElement.classList.contains("dark") ? "dark" : "light";

  const applyTheme = (theme: Theme, persist = false): void => {
    document.documentElement.classList.toggle("dark", theme === "dark");
    document.documentElement.style.colorScheme = theme;

    if (persist) {
      localStorage.setItem("theme", theme);
    }

    const button = document.querySelector<HTMLButtonElement>(
      "[data-theme-toggle]"
    );
    button?.setAttribute("aria-pressed", String(theme === "dark"));
    button?.setAttribute(
      "aria-label",
      theme === "dark" ? "Switch to light theme" : "Switch to dark theme"
    );
  };

  const toggleTheme = async (event: MouseEvent): Promise<void> => {
    const nextTheme = getCurrentTheme() === "dark" ? "light" : "dark";
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;
    const transitionDocument = document as ThemeTransitionDocument;

    if (!transitionDocument.startViewTransition || prefersReducedMotion) {
      applyTheme(nextTheme, true);
      return;
    }

    const button = event.currentTarget as HTMLButtonElement;
    const buttonRect = button.getBoundingClientRect();
    const isKeyboardActivation = event.detail === 0;
    const x = isKeyboardActivation
      ? buttonRect.left + buttonRect.width / 2
      : event.clientX;
    const y = isKeyboardActivation
      ? buttonRect.top + buttonRect.height / 2
      : event.clientY;
    const endRadius = Math.hypot(
      Math.max(x, window.innerWidth - x),
      Math.max(y, window.innerHeight - y)
    );
    document.documentElement.dataset.themeTransition = "true";
    const transition = transitionDocument.startViewTransition(() => {
      applyTheme(nextTheme, true);
    });

    try {
      await transition.ready;
      const animation = document.documentElement.animate(
        {
          clipPath: [
            `circle(0px at ${x}px ${y}px)`,
            `circle(${endRadius}px at ${x}px ${y}px)`,
          ],
        },
        {
          duration: 450,
          easing: "cubic-bezier(0.2, 0, 0, 1)",
          pseudoElement: "::view-transition-new(root)",
        }
      );
      await animation.finished;
    } finally {
      await transition.finished.catch(() => undefined);
      delete document.documentElement.dataset.themeTransition;
    }
  };

  const initializeThemeToggle = (): void => {
    applyTheme(getStoredTheme() ?? getSystemTheme());

    const button = document.querySelector<HTMLButtonElement>(
      "[data-theme-toggle]"
    );
    if (!button || button.dataset.themeToggleReady === "true") {
      return;
    }

    button.dataset.themeToggleReady = "true";
    button.addEventListener("click", toggleTheme);
  };

  initializeThemeToggle();
  document.addEventListener("astro:after-swap", initializeThemeToggle);
</script>

<script is:inline>
  (() => {
    const storedTheme = localStorage.getItem("theme");
    const systemTheme = window.matchMedia("(prefers-color-scheme: dark)")
      .matches
      ? "dark"
      : "light";
    const theme =
      storedTheme === "dark" || storedTheme === "light"
        ? storedTheme
        : systemTheme;

    document.documentElement.classList.toggle("dark", theme === "dark");
  })();
</script>

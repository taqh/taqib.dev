---
import type { HTMLAttributes } from "astro/types";
import { cn } from "@/lib/utils";

interface Props extends HTMLAttributes<"article"> {}
const { class: classNames, ...attrs } = Astro.props;
---

<article
  {...attrs}
  class={cn(
    "prose prose-taqib w-full min-w-0 max-w-full prose-headings:text-balance prose-figcaption:text-center prose-headings:font-medium prose-headings:font-sans prose-figcaption:text-xs text-base prose-figcaption:italic prose-li:leading-7 prose-p:leading-7 prose-code:before:content-none prose-code:after:content-none",
    classNames,
  )}
>
  <slot />
</article>

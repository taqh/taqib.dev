<div id="dot"></div>

<style>
  #dot {
    position: fixed;
    top: 50%;
    left: 50%;
    z-index: 100;
    display: none;
    height: 6px;
    aspect-ratio: 1;
    pointer-events: none;
    background: hsl(var(--background));
    border-radius: 50%;
    mix-blend-mode: difference;
    translate: -50% -50%;

    @media (min-width: 600px) and (pointer: fine) and (
        prefers-reduced-motion: no-preference
      ) {
      display: block;
    }
  }
  html.dark #dot {
    background: hsl(var(--foreground));
  }
</style>

<script>
  const shouldTrackPointer = (): boolean =>
    window.matchMedia(
      "(min-width: 600px) and (pointer: fine) and (prefers-reduced-motion: no-preference)"
    ).matches;

  function setupTracker(): () => void {
    const dot = document.getElementById("dot");

    function handlePointerMove(event: PointerEvent): void {
      const { clientX, clientY } = event;

      if (dot) {
        dot.animate(
          {
            left: `${clientX}px`,
            top: `${clientY}px`,
          },
          {
            duration: 1200,
            easing: "cubic-bezier(0.2, 0, 0, 1)",
            fill: "forwards",
          }
        );
      }
    }

    if (shouldTrackPointer()) {
      document.body.addEventListener("pointermove", handlePointerMove);
    }

    return () => {
      document.body.removeEventListener("pointermove", handlePointerMove);
    };
  }

  // Initialize on page load
  let cleanup: (() => void) | undefined;

  document.addEventListener("astro:page-load", () => {
    cleanup?.();
    cleanup = setupTracker();
  });

  // Cleanup before page transitions
  document.addEventListener("astro:before-swap", () => {
    cleanup?.();
  });

  // Initial setup
  cleanup = setupTracker();
</script>

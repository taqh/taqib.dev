---
interface Props {
  href: string;
}

const { href } = Astro.props;
---

<a
  aria-label="See all"
  class="group inline-flex w-fit items-center gap-1.5 text-base text-muted-foreground transition-colors duration-200 hover:text-foreground focus-visible:outline-dashed focus-visible:outline-2 focus-visible:outline-accent"
  href={href}
>
  <slot />
  <svg
    aria-hidden="true"
    class="size-4 fill-none stroke-current transition-transform duration-200 group-hover:translate-x-0.5"
    viewBox="0 0 24 24"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path
      d="m9 18 6-6-6-6"
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="1.5"
    />
  </svg>
</a>

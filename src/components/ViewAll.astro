---
interface Props {
  href: string;
  label: string;
}

const { href, label } = Astro.props;
---

<a
  class="group text-muted-foreground hover:text-foreground focus-visible:outline-accent inline-flex w-fit items-center gap-1.5 text-base transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-dashed"
  href={href}
>
  {label}
  <svg
    aria-hidden="true"
    class="size-4 fill-none stroke-current transition-transform duration-200 group-hover:translate-x-0.5"
    viewBox="0 0 24 24"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path
      d="m9 18 6-6-6-6"
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="1.5"
    />
  </svg>
</a>

---
interface Props {
  entry: {
    title: string;
    links: {
      repo: string;
      live: string;
    };
    description: string;
  };
}

const { entry } = Astro.props as Props;
const { title, links, description } = entry;
---

<li>
  <a
    class="group -mx-3 block rounded-lg px-3 py-3 transition-colors duration-200 hover:bg-muted/70 focus-visible:outline-dashed focus-visible:outline-2 focus-visible:outline-accent"
    href={links.live}
    rel="noopener"
    target="_blank"
  >
    <div class="space-y-1">
      <p class="text-base leading-6">
        {title}
      </p>
      <p class="text-base leading-6 text-muted-foreground">
        {description}
      </p>
    </div>
  </a>
</li>

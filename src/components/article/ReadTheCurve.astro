<figure class="curve-reader-figure">
  <curve-reader class="curve-reader">
    <div class="reader-card">
      <svg
        aria-labelledby="curve-reader-title curve-reader-description"
        class="reader-graph"
        role="img"
        viewBox="0 0 760 720"
      >
        <title id="curve-reader-title">
          Read progress from the curve, not its control handles
        </title>
        <desc id="curve-reader-description">
          A time versus progress graph for cubic-bezier 0.5, 0.43, 0.25, 1. The
          second control handle sits at 25 percent time and 100 percent
          progress, but at 25 percent elapsed time the curve returns about 32
          percent progress.
        </desc>

        <defs>
          <marker
            id="curve-reader-arrow"
            markerHeight="7"
            markerWidth="7"
            orient="auto-start-reverse"
            refX="8"
            refY="5"
            viewBox="0 0 10 10"
          >
            <path
              d="M2 1 8 5 2 9"
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
            ></path>
          </marker>
          <pattern
            height="52"
            id="curve-reader-grid"
            patternUnits="userSpaceOnUse"
            width="52"
            x="146"
            y="116"
          >
            <circle class="grid-dot" cx="26" cy="26" r="1.3"></circle>
          </pattern>
        </defs>

        <rect class="grid" height="468" width="468" x="146" y="116"></rect>

        <g class="reference-lines">
          <path d="M120 610H660" marker-end="url(#curve-reader-arrow)"></path>
          <path d="M120 610V70" marker-end="url(#curve-reader-arrow)"></path>
          <path class="quiet" d="M120 90H640V610"></path>
        </g>

        <g class="axis-labels">
          <text text-anchor="middle" x="380" y="705">elapsed time</text>
          <text
            text-anchor="middle"
            transform="rotate(-90 58 350)"
            x="58"
            y="350"
          >
            progress
          </text>
          <text text-anchor="middle" x="120" y="640">0</text>
          <text text-anchor="middle" x="640" y="640">1</text>
          <text text-anchor="end" x="102" y="615">0</text>
          <text text-anchor="end" x="102" y="95">1</text>
        </g>

        <g class="handle-guides">
          <path class="guide-one" d="M120 610 380 386.4"></path>
          <path class="guide-two" d="M250 90 640 90"></path>
        </g>

        <path class="easing-curve" d="M120 610C380 386.4 250 90 640 90"></path>

        <g class="fixed-points">
          <circle cx="120" cy="610" r="6"></circle>
          <circle cx="640" cy="90" r="6"></circle>
        </g>

        <g class="control-point control-point-one">
          <circle cx="380" cy="386.4" r="10"></circle>
          <text text-anchor="middle" x="380" y="361">P₁</text>
        </g>
        <g class="control-point control-point-two">
          <circle cx="250" cy="90" r="10"></circle>
          <text text-anchor="middle" x="250" y="60">P₂ · handle</text>
        </g>

        <g class="probe">
          <path d="M250 610V90" data-probe-vertical></path>
          <path d="M120 446H250" data-probe-horizontal></path>
          <circle cx="250" cy="446" data-curve-point r="9"></circle>
          <text data-time-label text-anchor="middle" x="250" y="665">25%</text>
          <text data-progress-label text-anchor="end" x="102" y="451">
            ≈32%
          </text>
          <text data-output-label x="268" y="439">curve output</text>
        </g>
      </svg>

      <div aria-hidden="true" class="comparison">
        <div>
          <span>P₂ · control handle</span>
          <strong>x-position 25% · y-position 100%</strong>
        </div>
        <div>
          <span>Point on the curve</span>
          <strong data-comparison-output>25% time · ≈32% progress</strong>
        </div>
      </div>

      <section aria-label="Progress applied to an object" class="motion-demo">
        <div aria-hidden="true" class="track-labels">
          <span>start</span>
          <span>finish</span>
        </div>
        <div class="motion-track" data-motion-track>
          <div class="motion-ball" data-motion-ball></div>
        </div>
      </section>

      <div class="time-control">
        <label for="curve-reader-time">
          Elapsed time
          <output data-time-output for="curve-reader-time">25%</output>
        </label>
        <input
          data-time-input
          id="curve-reader-time"
          max="1"
          min="0"
          step="0.01"
          type="range"
          value="0.25"
        >
      </div>
    </div>
  </curve-reader>
</figure>

<script>
  const CURVE_READER_GRAPH = {
    bottom: 610,
    height: 520,
    left: 120,
    top: 90,
    width: 520,
  };

  const CURVE_READER_POINTS = {
    x1: 0.5,
    x2: 0.25,
    y1: 0.43,
    y2: 1,
  };

  class CurveReader extends HTMLElement {
    currentTime = 0.25;
    resizeObserver: ResizeObserver | null = null;

    connectedCallback() {
      if (this.dataset.ready === "true") {
        return;
      }
      this.dataset.ready = "true";

      const input = this.querySelector<HTMLInputElement>("[data-time-input]");
      input?.addEventListener("input", () => {
        this.render(Number(input.value));
      });

      const track = this.querySelector<HTMLElement>("[data-motion-track]");
      if (track) {
        this.resizeObserver = new ResizeObserver(() => {
          this.render(this.currentTime);
        });
        this.resizeObserver.observe(track);
      }

      this.render(this.currentTime);
    }

    disconnectedCallback() {
      this.resizeObserver?.disconnect();
    }

    bezierAtParameter(parameter: number, point1: number, point2: number) {
      const inverse = 1 - parameter;
      return (
        3 * inverse * inverse * parameter * point1 +
        3 * inverse * parameter * parameter * point2 +
        parameter * parameter * parameter
      );
    }

    clamp(value: number, minimum: number, maximum: number) {
      return Math.min(Math.max(value, minimum), maximum);
    }

    progressAtTime(time: number) {
      let lowerBound = 0;
      let upperBound = 1;

      for (let iteration = 0; iteration < 24; iteration += 1) {
        const parameter = (lowerBound + upperBound) / 2;
        const x = this.bezierAtParameter(
          parameter,
          CURVE_READER_POINTS.x1,
          CURVE_READER_POINTS.x2
        );

        if (x < time) {
          lowerBound = parameter;
        } else {
          upperBound = parameter;
        }
      }

      return this.bezierAtParameter(
        (lowerBound + upperBound) / 2,
        CURVE_READER_POINTS.y1,
        CURVE_READER_POINTS.y2
      );
    }

    render(nextTime: number) {
      const time = this.clamp(nextTime, 0, 1);
      const progress =
        time === 0 || time === 1 ? time : this.progressAtTime(time);
      this.currentTime = time;

      const graphX = CURVE_READER_GRAPH.left + time * CURVE_READER_GRAPH.width;
      const graphY =
        CURVE_READER_GRAPH.bottom - progress * CURVE_READER_GRAPH.height;
      const timePercentage = `${Math.round(time * 100)}%`;
      const rawProgressPercentage = progress * 100;
      const roundedProgressPercentage = Math.round(rawProgressPercentage);
      const progressPercentage = `${roundedProgressPercentage}%`;
      const progressIsApproximate =
        Math.abs(rawProgressPercentage - roundedProgressPercentage) > 0.0001;
      const compactProgressPercentage = `${
        progressIsApproximate ? "≈" : ""
      }${progressPercentage}`;

      this.querySelector<SVGPathElement>("[data-probe-vertical]")?.setAttribute(
        "d",
        `M${graphX} ${CURVE_READER_GRAPH.bottom}V${CURVE_READER_GRAPH.top}`
      );
      this.querySelector<SVGPathElement>(
        "[data-probe-horizontal]"
      )?.setAttribute("d", `M${CURVE_READER_GRAPH.left} ${graphY}H${graphX}`);

      const curvePoint =
        this.querySelector<SVGCircleElement>("[data-curve-point]");
      curvePoint?.setAttribute("cx", String(graphX));
      curvePoint?.setAttribute("cy", String(graphY));

      const timeLabel = this.querySelector<SVGTextElement>("[data-time-label]");
      timeLabel?.setAttribute("x", String(graphX));
      if (timeLabel) {
        timeLabel.textContent = timePercentage;
      }

      const progressLabel = this.querySelector<SVGTextElement>(
        "[data-progress-label]"
      );
      const progressLabelIsNearEndpoint = progress < 0.08 || progress > 0.92;
      progressLabel?.setAttribute(
        "x",
        String(progressLabelIsNearEndpoint ? 82 : 102)
      );
      progressLabel?.setAttribute("y", String(graphY + 5));
      if (progressLabel) {
        progressLabel.textContent = compactProgressPercentage;
      }

      const outputLabel = this.querySelector<SVGTextElement>(
        "[data-output-label]"
      );
      const labelAppearsBeforePoint = time > 0.62;
      outputLabel?.setAttribute(
        "x",
        String(graphX + (labelAppearsBeforePoint ? -16 : 16))
      );
      outputLabel?.setAttribute("y", String(graphY - 10));
      outputLabel?.setAttribute(
        "text-anchor",
        labelAppearsBeforePoint ? "end" : "start"
      );

      const ball = this.querySelector<HTMLElement>("[data-motion-ball]");
      const track = this.querySelector<HTMLElement>("[data-motion-track]");
      if (ball && track) {
        const travelDistance = Math.max(
          track.clientWidth - ball.clientWidth,
          0
        );
        ball.style.transform = `translate(${travelDistance * progress}px, -50%)`;
      }

      const input = this.querySelector<HTMLInputElement>("[data-time-input]");
      if (input && Number(input.value) !== time) {
        input.value = String(time);
      }

      const timeOutput =
        this.querySelector<HTMLOutputElement>("[data-time-output]");
      if (timeOutput) {
        timeOutput.value = timePercentage;
      }

      const comparisonOutput = this.querySelector<HTMLElement>(
        "[data-comparison-output]"
      );
      if (comparisonOutput) {
        comparisonOutput.textContent = `${timePercentage} time · ${compactProgressPercentage} progress`;
      }
    }
  }

  if (!customElements.get("curve-reader")) {
    customElements.define("curve-reader", CurveReader);
  }
</script>

<style>
  .curve-reader-figure {
    --pair-one: hsl(210 78% 43%);
    --pair-two: hsl(28 82% 40%);
    margin: 2.5rem 0;
  }

  :global(.dark) .curve-reader-figure {
    --pair-one: hsl(210 92% 68%);
    --pair-two: hsl(32 90% 66%);
  }

  .curve-reader {
    display: block;
    min-width: 0;
  }

  .reader-card {
    min-width: 0;
    padding: clamp(0.85rem, 2.5vw, 1.5rem);
    background: hsl(var(--card));
    border: 1px solid hsl(var(--border));
    border-radius: 0.75rem;
  }

  .reader-graph {
    display: block;
    width: 100%;
    max-width: 52rem;
    height: auto;
    margin: 0 auto;
  }

  .grid {
    color: hsl(var(--muted-foreground) / 0.24);
    fill: url("#curve-reader-grid");
  }

  .grid-dot {
    fill: currentColor;
  }

  .reference-lines {
    color: hsl(var(--muted-foreground) / 0.78);
  }

  .reference-lines path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  .reference-lines .quiet {
    stroke: hsl(var(--muted-foreground) / 0.24);
    stroke-linecap: butt;
    stroke-dasharray: 5 8;
  }

  .axis-labels text,
  .probe text,
  .control-point text {
    font-family: var(--font-inter), system-ui, sans-serif;
    fill: hsl(var(--muted-foreground));
  }

  .axis-labels text {
    font-size: 13px;
  }

  .handle-guides path,
  .probe path {
    fill: none;
    stroke-width: 1.5;
    stroke-dasharray: 6 6;
  }

  .guide-one {
    stroke: var(--pair-one);
    stroke-opacity: 0.6;
  }

  .guide-two {
    stroke: var(--pair-two);
    stroke-opacity: 0.6;
  }

  .easing-curve {
    fill: none;
    stroke: hsl(var(--accent));
    stroke-width: 5;
    stroke-linecap: round;
  }

  .fixed-points circle {
    fill: hsl(var(--foreground));
  }

  .control-point circle {
    fill: hsl(var(--card));
    stroke-width: 4;
  }

  .control-point-one circle {
    stroke: var(--pair-one);
  }

  .control-point-two circle {
    stroke: var(--pair-two);
  }

  .control-point text {
    font-size: 14px;
    font-weight: 700;
    fill: hsl(var(--foreground));
    stroke: hsl(var(--card));
    stroke-width: 5px;
    paint-order: stroke;
  }

  .probe path {
    stroke: hsl(var(--accent) / 0.52);
  }

  .probe circle {
    fill: hsl(var(--card));
    stroke: hsl(var(--accent));
    stroke-width: 5;
  }

  .probe text {
    font-size: 13px;
  }

  .probe text[data-output-label] {
    font-weight: 700;
    fill: hsl(var(--foreground));
    stroke: hsl(var(--card));
    stroke-width: 5px;
    paint-order: stroke;
  }

  .comparison {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: -0.25rem;
  }

  .comparison div {
    display: grid;
    gap: 0.2rem;
    padding: 0.75rem 0.85rem;
    background: hsl(var(--background) / 0.48);
    border: 1px solid hsl(var(--border));
    border-radius: 0.55rem;
  }

  .comparison span {
    font-size: 0.6875rem;
    color: hsl(var(--muted-foreground));
  }

  .comparison strong {
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.75rem;
    color: hsl(var(--foreground));
  }

  .comparison div:first-child {
    border-color: color-mix(in srgb, var(--pair-two) 45%, transparent);
  }

  .comparison div:last-child {
    border-color: hsl(var(--accent) / 0.42);
  }

  .motion-demo {
    padding: 1rem;
    margin-top: 1rem;
    border: 1px solid hsl(var(--foreground) / 0.16);
    border-radius: 0.6rem;
  }

  .track-labels {

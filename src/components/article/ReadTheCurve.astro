    height: 6px;
    content: "";
    background: hsl(var(--foreground) / 0.72);
    border-radius: 999px;
    transform: translateY(-50%);
  }

  .motion-track::before {
    left: 0;
  }

  .motion-track::after {
    right: 0;
  }

  .motion-ball {
    position: absolute;
    top: 50%;
    left: 0;
    width: 1.4rem;
    height: 1.4rem;
    background: hsl(var(--accent));
    border: 4px solid hsl(var(--card));
    border-radius: 999px;
  }

  .time-control {
    display: grid;
    grid-template-columns: minmax(8rem, 0.35fr) minmax(0, 1fr);
    gap: 1rem;
    align-items: center;
    margin-top: 1rem;
  }

  .time-control label {
    display: flex;
    gap: 0.75rem;
    justify-content: space-between;
    font-size: 0.8125rem;
    color: hsl(var(--muted-foreground));
  }

  .time-control output {
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-weight: 700;
    color: hsl(var(--foreground));
  }

  .time-control input {
    width: 100%;
    accent-color: hsl(var(--accent));
    cursor: pointer;
  }

  .time-control input:focus-visible {
    outline: 2px dashed hsl(var(--accent));
    outline-offset: 3px;
  }

  @media (max-width: 560px) {
    .axis-labels text,
    .probe text {
      font-size: 18px;
    }

    .control-point text {
      font-size: 19px;
    }

    .comparison {
      grid-template-columns: 1fr;
      margin-top: 0;
    }

    .time-control {
      grid-template-columns: 1fr;
      gap: 0.6rem;
    }
  }
</style>

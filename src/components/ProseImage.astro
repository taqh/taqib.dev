---
import { Image } from "astro:assets";

interface Props {
  alt: string;
  caption?: string;
  class?: string;
  src: ImageMetadata;
}
const { src, alt, class: className, caption } = Astro.props;
---

<div>
  <Image
    alt={alt}
    class={`${className ? className : ""} border border-dashed`}
    src={src}
  />
  {caption && (
      <p class="mx-auto -mt-5 w-fit text-center text-muted-foreground text-xs">
        {caption}
      </p>
    )}
</div>

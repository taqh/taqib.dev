---
import BackLink from "@/components/BackLink.astro";
import Container from "@/components/Container.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import Layout from "@/layouts/Layout.astro";
import { ACTIVE_PROJECTS, SITE } from "@/lib/constants";
---

<Layout
  description="A list of projects I've worked on or am currently working on."
  title={`Projects - ${SITE.TITLE}`}
>
  <Container class="pt-24 pb-24 sm:pt-28 sm:pb-32">
    <div class="mb-16 flex items-center justify-between">
      <BackLink href="/" title="Back home" />
      <ThemeToggle />
    </div>
    <div class="space-y-8">
      <div class="space-y-2">
        <h1 class="font-serif text-2xl leading-tight font-medium">Projects</h1>
        <p class="text-muted-foreground text-base leading-7">
          A list of projects I've worked on or currently working on.
        </p>
      </div>
      <ul class="flex flex-col gap-4">
        {ACTIVE_PROJECTS.map((project) => <ProjectCard entry={project} />)}
      </ul>
    </div>
  </Container>
</Layout>

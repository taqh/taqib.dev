---
import { getCollection } from "astro:content";
import ContactLinks from "@/components/ContactLinks.astro";
import Container from "@/components/Container.astro";
import Header from "@/components/Header.astro";
import PostCard from "@/components/PostCard.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import ViewAll from "@/components/ViewAll.astro";
import Layout from "@/layouts/Layout.astro";
import { PROJECTS, SITE } from "@/lib/constants";

const [articles, remotePosts] = await Promise.all([
  getCollection("articles", ({ data }) => !data.draft),
  getCollection("posts"),
]);
const localSlugs = new Set(articles.map((entry) => entry.id));
const posts = [
  ...articles,
  ...remotePosts.filter((entry) => !localSlugs.has(entry.data.slug)),
].sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
---

<Layout description={SITE.DESCRIPTION} title={SITE.TITLE}>
  <Container class="pb-24 pt-24 sm:pb-32 sm:pt-28">
    <Header />
    <div class="mt-16 space-y-24 sm:mt-20 sm:space-y-28">
      <section id="about">
        <div class="space-y-4 text-base leading-7 text-muted-foreground">
          <p>
            Frontend engineer based in Abuja, Nigeria. I build products across
            the stack, with a soft spot for open source and developer tools.
          </p>
          <p>
            I&apos;m currently maintaining{" "}
            <a
              class="text-foreground underline decoration-foreground/30 underline-offset-[3px] transition-colors hover:decoration-foreground focus-visible:outline-dashed focus-visible:outline-2 focus-visible:outline-accent"
              href="https://marblecms.com?ref=taqib.dev"
              rel="noopener"
              target="_blank"
              >marble</a
            >{" "}
            and exploring agents, interface design, and motion.
          </p>
        </div>
        <ContactLinks class="mt-6" />
      </section>

      <section class="space-y-5" id="projects">
        <h2 class="font-serif text-lg font-medium leading-tight">Projects</h2>
        <ul class="flex flex-col gap-4">
          {PROJECTS.slice(0, 4).map((project) => (
              <ProjectCard entry={project} />
            ))}
        </ul>
        {PROJECTS.length > 4 && (
            <ViewAll href="/projects">See all projects</ViewAll>
          )}
      </section>

      <section class="space-y-5" id="posts">
        <h2 class="font-serif text-lg font-medium leading-tight">Notes</h2>
        <ul class="flex flex-col gap-4">
          {posts.slice(0, 4).map((post) => <PostCard entry={post} />)}
        </ul>
        {posts.length > 4 && <ViewAll href="/blog">See all notes</ViewAll>}
      </section>
    </div>
  </Container>
</Layout>

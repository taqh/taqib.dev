---
import { getCollection } from "astro:content";
import ContactLinks from "@/components/ContactLinks.astro";
import Container from "@/components/Container.astro";
import Header from "@/components/Header.astro";
import PostCard from "@/components/PostCard.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import ViewAll from "@/components/ViewAll.astro";
import WorkCard from "@/components/work/WorkCard.astro";
import Layout from "@/layouts/Layout.astro";
import { ACTIVE_PROJECTS, SITE } from "@/lib/constants";
import { getWorkEntries } from "@/lib/work";

const [articles, remotePosts, work] = await Promise.all([
  getCollection("articles", ({ data }) => !data.draft),
  getCollection("posts"),
  getWorkEntries(),
]);
const localSlugs = new Set(articles.map((entry) => entry.id));
const posts = [
  ...articles,
  ...remotePosts.filter((entry) => !localSlugs.has(entry.data.slug)),
].sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
---

<Layout description={SITE.DESCRIPTION} title={SITE.TITLE}>
  <Container class="pt-24 pb-24 sm:pt-28 sm:pb-32">
    <Header />
    <div class="mt-10 space-y-24">
      <section id="about">
        <div class="text-muted-foreground space-y-4 text-base leading-7">
          <p>
            Software engineer based in Abuja, Nigeria. I build products across
            the stack, with a soft spot for open source and developer tools.
          </p>
          <p>
            I&apos;m currently maintaining{" "}
            <a
              class="text-foreground decoration-foreground/30 hover:decoration-foreground focus-visible:outline-accent underline underline-offset-[3px] transition-colors focus-visible:outline-2 focus-visible:outline-dashed"
              href="https://marblecms.com?ref=taqib.dev"
              rel="noopener"
              target="_blank"
              >marble</a
            >{" "}
            and exploring agents and interface design.
          </p>
        </div>
        <ContactLinks class="mt-6" />
      </section>

      <section class="space-y-5" id="projects">
        <h2 class="font-serif text-lg leading-tight font-medium">Projects</h2>
        <ul class="flex flex-col gap-4">
          {ACTIVE_PROJECTS.map((project) => <ProjectCard entry={project} />)}
        </ul>
      </section>

      {work.length > 0 && (
        <section class="space-y-5" id="work">
          <h2 class="font-serif text-lg leading-tight font-medium">Work</h2>
          <ul class="flex flex-col gap-4">
            {work.slice(0, 4).map((entry) => (
              <WorkCard entry={entry} />
            ))}
          </ul>
          {work.length > 4 && <ViewAll href="/work" label="See all work" />}
        </section>
      )}

      <section class="space-y-5" id="posts">
        <h2 class="font-serif text-lg leading-tight font-medium">Notes</h2>
        <ul class="flex flex-col gap-4">
          {posts.slice(0, 4).map((post) => <PostCard entry={post} />)}
        </ul>
        {posts.length > 4 && <ViewAll href="/blog" label="See all notes" />}
      </section>
    </div>
  </Container>
</Layout>

---
import { type CollectionEntry, getCollection, render } from "astro:content";
import BackLink from "@/components/BackLink.astro";
import Container from "@/components/Container.astro";
import Prose from "@/components/Prose.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import BlogLayout from "@/layouts/BlogLayout.astro";
import { calculateReadTime, formatDate } from "@/lib/utils";

export const prerender = true;

type BlogEntry = CollectionEntry<"articles"> | CollectionEntry<"posts">;

export async function getStaticPaths() {
  const [articles, remotePosts] = await Promise.all([
    getCollection("articles", ({ data }) => !data.draft),
    getCollection("posts"),
  ]);
  const localSlugs = new Set(articles.map((articleEntry) => articleEntry.id));
  const entries: BlogEntry[] = [
    ...articles,
    ...remotePosts.filter((postEntry) => !localSlugs.has(postEntry.data.slug)),
  ];

  return entries.map((blogEntry) => ({
    params: {
      slug:
        blogEntry.collection === "articles"
          ? blogEntry.id
          : blogEntry.data.slug,
    },
    props: { entry: blogEntry },
  }));
}

const { entry } = Astro.props as { entry: BlogEntry };
const isLocalArticle = entry.collection === "articles";
const renderedArticle = isLocalArticle ? await render(entry) : undefined;
const Content = renderedArticle?.Content;
const formattedDate = formatDate(entry.data.publishedAt);
const readTime = isLocalArticle
  ? (entry.data.readingTime ?? calculateReadTime(entry.body ?? ""))
  : calculateReadTime(entry.data.content);
const image =
  entry.collection === "posts"
    ? (entry.data.coverImage ?? undefined)
    : entry.data.image;
const remoteContent =
  entry.collection === "posts" ? entry.data.content : undefined;
---

<BlogLayout
  description={entry.data.description}
  image={image}
  title={entry.data.title}
>
  <Container class="min-w-0 max-w-prose pb-24 pt-24 sm:pt-28 md:px-0 lg:px-0">
    <section class="mb-16 flex items-center justify-between">
      <BackLink
        href={isLocalArticle ? "/blog" : "/"}
        title={isLocalArticle ? "Notes" : "Home"}
      />
      <ThemeToggle />
    </section>
    <header class="mb-12 flex flex-col gap-4">
      <h1
        class="mb-2 text-balance font-serif text-2xl font-medium leading-tight sm:text-3xl"
      >
        {entry.data.title}
      </h1>
      <div
        class="flex flex-wrap items-center gap-x-2 text-base text-muted-foreground"
      >
        <time datetime={entry.data.publishedAt.toISOString()}
          >{formattedDate}</time
        >
        <span aria-hidden="true">·</span>
        <p>{`${readTime} minute read`}</p>
      </div>
    </header>
    <Prose>
      {Content ? <Content /> : <div set:html={remoteContent ?? ""} />}
    </Prose>
  </Container>
</BlogLayout>

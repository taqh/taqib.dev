---
import { getCollection } from "astro:content";
import BackLink from "@/components/BackLink.astro";
import Container from "@/components/Container.astro";
import PostCard from "@/components/PostCard.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import Layout from "@/layouts/Layout.astro";
import { SITE } from "@/lib/constants";

const [articles, remotePosts] = await Promise.all([
  getCollection("articles", ({ data }) => !data.draft),
  getCollection("posts"),
]);
const localSlugs = new Set(articles.map((entry) => entry.id));
const posts = [
  ...articles,
  ...remotePosts.filter((entry) => !localSlugs.has(entry.data.slug)),
].sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
---

<Layout description={SITE.DESCRIPTION} title={`Blog - ${SITE.TITLE}`}>
  <Container class="pb-24 pt-24 sm:pb-32 sm:pt-28">
    <div class="mb-16 flex items-center justify-between">
      <BackLink href="/" title="Home" />
      <ThemeToggle />
    </div>
    <h1 class="mb-8 font-serif text-2xl font-medium leading-tight">Notes</h1>
    <ul class="flex flex-col gap-4">
      {posts.map((post) => <PostCard entry={post} />)}
    </ul>
  </Container>
</Layout>

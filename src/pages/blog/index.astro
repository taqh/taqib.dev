---
import { getCollection } from "astro:content";
import Container from "@/components/Container.astro";
import PostCard from "@/components/PostCard.astro";
import Layout from "@/layouts/Layout.astro";
import { SITE } from "@/lib/constants";

const [articles, remotePosts] = await Promise.all([
  getCollection("articles", ({ data }) => !data.draft),
  getCollection("posts"),
]);
const localSlugs = new Set(articles.map((entry) => entry.id));
const posts = [
  ...articles,
  ...remotePosts.filter((entry) => !localSlugs.has(entry.data.slug)),
].sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
---

<Layout description={SITE.DESCRIPTION} title={`Blog - ${SITE.TITLE}`}>
  <Container class="py-20 sm:py-24 lg:py-28">
    <div class="mb-10 space-y-2">
      <h1
        class="font-medium font-serif text-2xl leading-[1.1] sm:text-3xl md:text-4xl"
      >
        Notes
      </h1>
    </div>
    <ul class="flex flex-col gap-6">
      {posts.map((post) => (
          <li>
            <PostCard entry={post} />
          </li>
        ))}
    </ul>
  </Container>
</Layout>

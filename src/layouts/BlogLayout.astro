---
import Head from "@/components/Head.astro";
import ScrollFades from "@/components/ScrollFades.astro";
import "@/styles/global.css";

const { title, description, image } = Astro.props;
---

<html lang="en">
  <head>
    <Head description={description} image={image} title={title} />
  </head>
  <body class="grid grid-rows-[auto_1fr_auto] overflow-x-hidden relative">
    <main class="min-w-0">
      <slot />
    </main>
    <ScrollFades />
    <!-- <BackToTop /> -->
  </body>
</html>
